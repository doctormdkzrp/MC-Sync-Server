{
  "name": "@mc-sync/server",
  "version": "0.3.0",
  "description": "mc_sync_server 服务端：客户端同步接口 + 发布管理台（Node + TypeScript + Fastify）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
